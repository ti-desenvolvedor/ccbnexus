APP_NAME="CCB NEXUS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Use um caminho absoluto no Windows/Herd se o caminho relativo falhar.
# Ex.: DB_DATABASE=C:/www/ccbnexus/database/database.sqlite
DB_DATABASE=database/database.sqlite

# Calendário da agenda: brasilapi (nacionais) ou catalog (lista local, sem rede).
HOLIDAY_SYNC_DRIVER=brasilapi

# MySQL local
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Hostinger (produção): copie .env.hostinger.example → .env no servidor
# No servidor Hostinger use DB_HOST=localhost (não o domínio).
# Domínio de produção: https://ccb.tinexus.com.br

# Deploy FTP da maquina local → Hostinger (php artisan ftp:push)
# Pegue host/usuario/senha em hPanel → Arquivos → Contas FTP
# DEPLOY_FTP_HOST=ftp.ccb.tinexus.com.br
# DEPLOY_FTP_USERNAME=
# DEPLOY_FTP_PASSWORD=
# DEPLOY_FTP_PORT=21
# DEPLOY_FTP_SSL=true
# DEPLOY_FTP_PASSIVE=true
# Se o FTP ja abre dentro de public_html, use ".." (laravel ao lado de public_html)
# DEPLOY_FTP_REMOTE_ROOT=..
# DEPLOY_FTP_CONCURRENCY=8
# DEPLOY_SSH_PATH=domains/ccb.tinexus.com.br
# DEPLOY_PHP_CLI=/opt/alt/php85/usr/bin/php

# Senha inicial do usuário admin (DevAdminUserSeeder + nexus:seed-embu-agenda)
INITIAL_ADMIN_PASSWORD=
# Em produção deixe false. true faz db:seed regravar a senha (desloga o admin).
RESET_ADMIN_PASSWORD=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local (Mailpit): MAIL_HOST=mailpit MAIL_PORT=1025 MAIL_ENCRYPTION=null
# Hostinger produção/homolog:
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contato@ccb.tinexus.com.br
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contato@ccb.tinexus.com.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# SSH (hPanel → Avancado → SSH Access). Se vazio, reutiliza DEPLOY_FTP_*.
# DEPLOY_SSH_HOST=
# DEPLOY_SSH_USERNAME=
# DEPLOY_SSH_PASSWORD=
# DEPLOY_SSH_PORT=22

# PDF da Lista de Batismos convertido do Word (LibreOffice headless). Vazio = PDF pelo DomPDF.
NEXUS_SOFFICE_BIN=
NEXUS_SOFFICE_TIMEOUT=90
